{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "采购雷达",
  "version": "0.1.0",
  "identifier": "com.anner.procuremap",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "采购雷达 — 供应商情报工具",
        "width": 1440,
        "height": 960,
        "minWidth": 1200,
        "minHeight": 800,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
